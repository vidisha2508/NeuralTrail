# ====================================================
# Neural Trail ML Backend Environment Configuration
# ====================================================

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=true
DEVICE=cpu

# Default Vision Model
MODEL_TYPE=resnet18
MODEL_CHECKPOINT_PATH=./models/resnet18.pth
NUM_CLASSES=1000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# ====================================================
# Compute Provider Configuration
# Set to 'local' or 'digitalocean'
# ====================================================
COMPUTE_PROVIDER=local

# ====================================================
# DigitalOcean Cloud Compute Credentials (Optional)
# Never commit real credentials! Read strictly from environment.
# Prepared for:
#   - batch inference across multi-gigabyte datasets
#   - perturbation sweeps (continuous rotation, noise, blur)
#   - large experiments (multi-epoch manifold fine-tuning)
#   - Gemma inference (dedicated cloud GPU droplet endpoint)
# ====================================================
DO_API_TOKEN=
DO_DROPLET_ID=droplet-gpu-h100-nyc3
DO_REGION=nyc3
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_COMPUTE_ENDPOINT=
